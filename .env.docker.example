# Rechargement automatique des fichiers montés dans Docker Desktop.
CHOKIDAR_USEPOLLING=true

# URL publique utilisée par le navigateur ; ne jamais mettre de secret dans VITE_*.
VITE_API_BASE_URL=/api

# Backend publié sur le port 3000 de la machine hôte (Docker Desktop).
API_PROXY_TARGET=http://host.docker.internal:3000
